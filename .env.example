DATABASE_URL=postgresql://user:password@host:5432/dbname
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://your-railway-url.railway.app
ADMIN_PASSWORD=Admin1234!
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=customerservice@friendlypartyrental.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Friendly Party Rental NYC <customerservice@friendlypartyrental.com>

# --- Google Analytics (GA4) + Search Console (admin dashboard) ---
# Optional. When these are set, /admin/analytics shows live traffic and
# search numbers; otherwise the dashboard falls back to "Open in Google".
#
# Provide the service-account credential ONE of two ways:
#   GOOGLE_SERVICE_ACCOUNT_JSON  = the full service-account JSON, as a string
#   GOOGLE_APPLICATION_CREDENTIALS = path to a service-account JSON file
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Numeric GA4 property id (e.g. 431258108). Grant the service account
# Viewer access on this property.
GA_PROPERTY_ID=

# Search Console property. Use "sc-domain:friendlypartyrentalsc.com" for a
# domain property, or the full URL for a URL-prefix property. Add the
# service account as a user on the property.
GSC_SITE_URL=

# Optional NYC website analytics. Blank means off. Paid-ad configuration remains intentionally disabled unless explicitly added later.
# Use only separately verified SC destinations. These NEXT_PUBLIC values are
# embedded at build time, so changing them requires a rebuild/deploy.
NEXT_PUBLIC_NYC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_NYC_GOOGLE_ADS_ID=
NEXT_PUBLIC_NYC_GOOGLE_ADS_PURCHASE_LABEL=

PUBLIC_INDEXABLE=false
NYC_DELIVERY_FEES_JSON={}
