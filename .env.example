DATABASE_URL=postgresql://user:password@host:5432/dbname
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://friendlypartyrentalnyc.com
ADMIN_PASSWORD=Admin1234!
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe account ID of the standalone Friendly Party Rental NYC account (acct_...).
# Every payment write verifies that STRIPE_SECRET_KEY belongs to this account.
NYC_STRIPE_ACCOUNT_ID=
# Go-live switch for customer, staff, saved-card and autopay charges. Must be exactly
# "true" to allow charges; anything else keeps NYC online payments blocked.
NYC_ONLINE_PAYMENTS_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=customerservice@friendlypartyrental.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Friendly Party Rental NYC <customerservice@friendlypartyrental.com>

# --- Google Analytics (GA4) + Search Console (admin dashboard) ---
# Optional. When these are set, /admin/analytics shows live traffic and
# search numbers; otherwise the dashboard falls back to "Open in Google".
#
# Provide the service-account credential ONE of two ways:
#   GOOGLE_SERVICE_ACCOUNT_JSON  = the full service-account JSON, as a string
#   GOOGLE_APPLICATION_CREDENTIALS = path to a service-account JSON file
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Numeric GA4 property id (e.g. 431258108). Grant the service account
# Viewer access on this property.
GA_PROPERTY_ID=

# Search Console property for the NYC / Downstate location.
# Use the exact NYC property only; do not reuse the Syracuse or Greenville property.
GSC_SITE_URL=
NYC_GSC_PROPERTY=


# Optional NYC website analytics. Blank means off.
NEXT_PUBLIC_NYC_GA_MEASUREMENT_ID=

# Paid-ad configuration is intentionally not part of this location template yet.

PUBLIC_INDEXABLE=false
# Owner-approved delivery fee (dollars, above 0) per approved ZIP: {"<zip>":<fee>,...}.
# A ZIP that is missing here cannot check out online (never priced as free delivery).
NYC_DELIVERY_FEES_JSON={}
# Owner-approved minimum order and optional fees. Empty = online checkout blocked.
# Optional fees set to null (or left out) are not offered online. Keys:
# minimumOrderSubtotal (required), damageWaiverPercent, lastMinuteFee,
# exactDeliveryFee, exactPickupFee, lateExactPickupFee, approvedOn (YYYY-MM-DD).
NYC_CHECKOUT_POLICY_JSON=

NEXT_PUBLIC_SITE_URL=https://friendlypartyrentalnyc.com


# --- Scheduled jobs / internal automation ---
CRON_SECRET=
MARKETING_CRON_SECRET=
INCOMPLETE_ORDER_CRON_SECRET=
MARKETING_SITE_ORIGIN=https://friendlypartyrentalnyc.com

# --- Email / reply monitoring ---
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
OWNER_NOTIFICATION_EMAIL=customerservice@friendlypartyrental.com

# --- Optional operational integrations ---
SERPAPI_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
RENTSKETCH_WEBHOOK_SECRET=

# Stripe webhook secret must be created for the NYC endpoint; do not reuse another location's webhook secret.
