{
  "name": "friendly-party-rental",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run snapshot:wedding-art && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "postinstall": "prisma generate",
    "snapshot:wedding-art": "node scripts/snapshot-ny-wedding-art.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@stripe/react-stripe-js": "^2.8.0",
    "@stripe/stripe-js": "^3.3.0",
    "@zoom/meetingsdk": "^6.2.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "imapflow": "2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.363.0",
    "mailparser": "3.9.28",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "nodemailer": "9.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.2",
    "sharp": "0.35.4",
    "stripe": "^14.21.0",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "3.4.6",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.23",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3"
  }
}
