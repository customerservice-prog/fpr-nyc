// --- Rental Restriction ("Do Not Rent") system ---
// A RentalRestriction is a single staff-created "case" (e.g. one incident)
// that can carry multiple matching identifiers (customer, email, phone,
// address). Matching ANY active identifier blocks a new online booking.
// See lib/rentalRestrictions.ts for normalization + matching logic.
model RentalRestriction {
  id String @id @default(cuid())
  status String @default("ACTIVE") // ACTIVE | INACTIVE
  reasonCategory String
  internalNotes String?

  // Snapshot references only (plain strings, not relations) so this record
  // remains meaningful even if the source order/customer is later deleted.
  sourceOrderId String?
  sourceOrderNumber String?
  sourceCustomerId String?

  createdByName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?

  deactivatedAt DateTime?
  deactivatedByName String?
  deactivationReason String?

  identifiers RentalRestrictionIdentifier[]

  @@index([status])
}

model RentalRestrictionIdentifier {
  id String @id @default(cuid())
  restrictionId String
  restriction RentalRestriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)

  type String // CUSTOMER_ID | EMAIL | PHONE | ADDRESS
  normalizedValue String
  displayValue String

  // CUSTOMER_ID identifiers store the Customer.id here (plain string, no FK
  // relation - if the customer is deleted the identifier simply stops
  // matching anything, which is the desired safe behavior).
  customerIdRef String?

  // ADDRESS identifiers only:
  addressScope String? // EXACT_UNIT | ENTIRE_PROPERTY
  addressStreet String?
  addressUnit String?
  addressCity String?
  addressState String?
  addressZip String?

  createdAt DateTime @default(now())

  @@index([type, normalizedValue])
  @@index([restrictionId])
}

// A logged attempt where an online booking matched an active restriction and
// was NOT allowed to complete. No Order, Customer, or inventory reservation
// is ever created for a blocked attempt - this is purely a record so staff
// can help the customer if they call in.
model RestrictedCheckoutAttempt {
  id String @id @default(cuid())
  attemptedAt DateTime @default(now())
  firstName String?
  lastName String?
  email String?
  phone String?
  eventAddress String?
  eventCity String?
  eventState String?
  eventZip String?
  eventDate DateTime?
  cartSummary String?
  matchedRestrictionIds String[] @default([])
  matchTypes String[] @default([])
  status String @default("UNRESOLVED") // UNRESOLVED | CONTACTED | RESOLVED
  attemptCount Int @default(1)

  @@index([status])
}

