generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  username String @unique
  password String
  name String
  role String @default("admin")
  driverProfileId String? @unique
  driverProfile Driver? @relation("DriverStaffUser", fields: [driverProfileId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  picture String?
  displayToCustomer Boolean @default(true)
  scheduleProfile String?
  pricingProfile String @default("standard")
  sortOrder Int @default(0)
  bookableAfter DateTime?
  bookableAfterMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items Item[]
}

model Item {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  type String @default("Regular")
  cost Float
  quantity Int @default(1)
  sortOrder Int @default(0)
  picture String?
  displayToCustomer Boolean @default(true)
  scheduleProfile String?
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  status String @default("Available")
  attentionNotes String?
  lastInspectedAt DateTime?
  bookableAfter DateTime?
  bookableAfterMessage String?
  specialDisplayName String?
  sku String?
  setupArea String?
  actualSize String?
  attendants Int?
  ageGroup String?
  additionalImages String[] @default([])
  colorOptions String[] @default([])
  taxable Boolean @default(true)
  setupFee Float?
  internalNotes String?
  suggestedAddonIds String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems OrderItem[]
}

model Customer {
  id String @id @default(cuid())
  firstName String
  lastName String
  email String
  phone String?
  company String?
  secondaryPhone String?
  secondaryEmail String?
  customerType String @default("Customer")
  address String?
  city String?
  state String?
  zip String?
  notes String?
  creditStatus String @default("good")
  doNotRent Boolean @default(false)
  doNotRentNote String?
  unsubscribedFromMarketing Boolean @default(false)
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  rainchecks Raincheck[]
}

model Driver {
  id String @id @default(cuid())
  name String
  phone String?
  email String?
  vehicleInfo String?
  isActive Boolean @default(true)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveryOrders Order[] @relation("DeliveryDriver")
  pickupOrders Order[] @relation("PickupDriver")
  pin String? @unique
  locations DriverLocation[]
  timeEntries DriverTimeEntry[]
  staffUser User? @relation("DriverStaffUser")
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  status String @default("active")
  source String @default("online")
  eventDate DateTime
  eventEndDate DateTime?
  eventAddress String?
  eventCity String?
  eventState String?
  eventZip String?
  eventTimeSlot String?
  pickupTimeSlot String?
  deliveryType String @default("delivery")
  deliveryFee Float @default(0)
  deliveryDistance Float?
  subtotal Float @default(0)
  rentalDays Int @default(1)
  durationLabel String?
  durationFee Float @default(0)
  specialRequestFee Float @default(0)
  specialRequestNames String?
  taxAmount Float @default(0)
  taxRate Float @default(0)
  couponCode String?
  couponDiscount Float @default(0)
  raincheckId String?
  raincheck Raincheck? @relation(fields: [raincheckId], references: [id])
  raincheckApplied Float @default(0)
  damageWaiver Boolean @default(false)
  damageWaiverFee Float @default(0)
  depositAmount Float @default(0)
  tipAmount Float @default(0)
  totalAmount Float @default(0)
  amountPaid Float @default(0)
  balanceDue Float @default(0)
  stripeCustomerId String?
  savedPaymentMethodId String?
  autopayEnabled Boolean @default(false)
  cardSetupTokenHash String?
  cardSetupTokenExpiresAt DateTime?
  cardOnFileConsentAt DateTime?
  cardOnFileConsentIp String?
  cardOnFileConsentVersion String?
  autoChargeStatus String?
  autoChargeAttemptedAt DateTime?
  notes String?
  internalNotes String?
  stripePaymentId String?
  contractSignedAt DateTime?
  contractSignatureName String?
  contractSignatureIp String?
  incompleteFollowUpSentAt DateTime?
  incompleteFollowUp3SentAt DateTime?
  incompleteFollowUp7SentAt DateTime?
  followUpsPaused Boolean @default(false)
  checkoutDraftKey String? @unique
  checkoutStage String?
  checkoutLastSeenAt DateTime?
  checkoutCompletedAt DateTime?
  lastMinuteFeeAmount Float @default(0)
  driverId String?
  driver Driver? @relation("DeliveryDriver", fields: [driverId], references: [id])
  pickupDriverId String?
  pickupDriver Driver? @relation("PickupDriver", fields: [pickupDriverId], references: [id])
  routeSequence Int?
  pickupRouteSequence Int?
  setupSurface String?
  isPublicPark Boolean @default(false)
  referenceSource String?
  locationName String?
  generalDiscount Float @default(0)
  overrideTravelFee Float?
  overrideDepositAmount Float?
  overrideTaxAmount Float?
  overrideDamageWaiverFee Float?
  miscellaneousFees Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  payments Payment[]
  additionalCharges OrderAdditionalCharge[]
  contacts OrderContact[]
  deliveredAt DateTime?
  pickedUpAt DateTime?
  deliveryPhoto String?
  pickupPhoto String?
  prePayReminderSentAt DateTime?
  prePayReminderDisabled Boolean @default(false)
  balanceReminderSentAt DateTime?
  preRentalReminderSentAt DateTime?
  thankYouSentAt DateTime?
  oneYearReminderSentAt DateTime?

  // Staff must explicitly approve an order with $0.00 recorded (amountPaid = 0)
  // before it appears on the admin schedule/calendar. Existing orders were
  // backfilled to true; new orders default to false until paid or approved.
  scheduleApprovedUnpaid Boolean @default(false)

  // --- Rental Restriction ("Do Not Rent") safety fields ---
  // These record a one-time manager override of an active rental restriction
  // for THIS order only. The underlying RentalRestriction record is never
  // modified or deactivated by an override - it remains active for all
  // future bookings unless a staff member explicitly deactivates it.
  restrictionOverrideAt DateTime?
  restrictionOverrideByName String?
  restrictionOverrideReason String?
  restrictionMatchedIds String[] @default([])

  // --- Delivery / Pickup scheduling redesign (event time vs delivery window vs exact-time premium service) ---
  eventStartTime String?
  eventEndTime String?
  deliveryWindowStart String?
  deliveryWindowEnd String?
  exactDeliveryRequested Boolean @default(false)
  exactDeliveryTime String?
  exactDeliveryFee Float @default(0)
  pickupType String @default("flexible") // flexible | requiredBy | exact
  pickupRequiredByTime String?
  exactPickupTime String?
  exactPickupFee Float @default(0)
  latePickupApprovalRequired Boolean @default(false)

  // Which server pricing engine computed this order's totals (null = legacy/unverified
  // browser-supplied totals, which cannot be charged online). See lib/nycCheckoutPricing.ts.
  pricingVersion String?
}

model OrderItem {
  id String @id @default(cuid())
