// One row per Stripe webhook event delivered to /api/webhooks/stripe. Makes webhook
// processing idempotent (duplicate deliveries are acknowledged without re-processing)
// and keeps failed events visible so a payment is never silently lost. A failed row
// is retried automatically on Stripe's next delivery attempt.
model StripeWebhookEvent {
  id              String    @id
  type            String
  livemode        Boolean
  status          String    @default("processing") // processing | processed | ignored | rejected | failed
  attempts        Int       @default(1)
  paymentIntentId String?
  orderId         String?
  note            String?
  lastError       String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([paymentIntentId])
  @@index([orderId])
}
